---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"><channel>
<title>Perspective by Chunfeng (Caleb) Liu</title>
<link>{{ '/' | absolute_url | xml_escape }}#blog</link>
<description>New posts on AI infrastructure, technology and finance.</description>
{% for post in site.posts limit: 50 %}
<item>
<title>{{ post.title | xml_escape }}</title>
<link>{{ post.url | absolute_url | xml_escape }}</link>
<guid>{{ post.url | absolute_url | xml_escape }}</guid>
<pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
<description>{{ post.description | default: post.excerpt | strip_html | normalize_whitespace | xml_escape }}</description>
</item>
{% endfor %}
</channel></rss>
